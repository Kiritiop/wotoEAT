{
  "expo": {
    "name": "wotoEAT",
    "slug": "wotoeat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wotoeat",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wotoeat.app",
      "infoPlist": {
        "NSCameraUsageDescription": "wotoEAT uses your camera to scan grocery receipts.",
        "NSPhotoLibraryUsageDescription": "wotoEAT accesses your photos so you can scan a saved receipt image."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF7F0"
      },
      "package": "com.wotoeat.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "wotoEAT — What to Eat",
      "shortName": "wotoEAT",
      "description": "AI-powered meal planning tailored to your health goals, pantry, and taste.",
      "themeColor": "#16A34A",
      "backgroundColor": "#FBF7F0"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "wotoEAT uses your camera to scan grocery receipts.",
          "photosPermission": "wotoEAT accesses your photos so you can scan a saved receipt image.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
