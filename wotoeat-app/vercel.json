{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/share/:id", "destination": "/share/[id].html" },
    { "source": "/meal/:id", "destination": "/meal/[id].html" },
    { "source": "/(.*)", "destination": "/+not-found.html" }
  ]
}
