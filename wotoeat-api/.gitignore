# Environment variables — NEVER commit these
.env
.env.*
# ...but DO commit the template (matches the root .gitignore). Without this
# negation the .env.example onboarding template is silently un-committable.
!.env.example

# Python virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Distribution / packaging
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test coverage
.coverage
htmlcov/
