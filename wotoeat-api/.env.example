# wotoEAT backend (FastAPI) environment template.
# Copy to .env and fill in. NEVER commit the real .env.
# Only the variables below are read by the code (grep `os.getenv`).

# ── Required ──────────────────────────────────────────────────────────────────
# Groq API key — powers all AI calls (text + vision).
GROQ_API_KEY=

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase SERVICE-ROLE key (NOT the anon key). The backend bypasses RLS and
# isolates users by the verified JWT `sub`. The anon key makes pantry writes
# fail with RLS errors in the fire-and-forget paths.
SUPABASE_KEY=

# Required ONLY for legacy HS256 Supabase projects — the shared JWT secret used
# to verify access tokens. Projects on asymmetric (ES256/RS256) signing keys
# verify against the JWKS and can leave this blank. If a project is HS256 and
# this is unset, all authenticated requests fail closed (401).
SUPABASE_JWT_SECRET=

# ── Optional (sensible defaults in code) ──────────────────────────────────────
# CORS allow-list, comma-separated. Defaults to localhost + the prod web origins.
ALLOWED_ORIGINS=

# AI response cache TTL in seconds (default 3600).
CACHE_TTL_SECONDS=3600

# SQLite cache/rate-limit DB path (default /tmp/wotoeat_cache.db).
CACHE_DB=

# Pexels API key — image-cascade fallback (TheMealDB needs no key).
# PEXELS_API_KEY is no longer read. The stock-photo stage was removed on
# 2026-08-25; header photos come from TheMealDB or are generated.

# Unsplash access key — last-resort image fallback.

# Override the receipt-scan vision model if Groq deprecates the default
# (qwen/qwen3.6-27b, the only image-input model Groq offers).
# LEAVE BLANK unless you are deliberately pinning: a stale override here (or in
# Railway) pointing at a removed model 404s and every AI call returns 503.
GROQ_VISION_MODEL=

# Override the main text model if Groq deprecates the default
# (openai/gpt-oss-120b). Powers all meal/recipe/shopping generation.
# Same warning as above: blank is safer than a pin that can be decommissioned.
GROQ_TEXT_MODEL=

# Reasoning budget for models that support it (default "low"). gpt-oss bills
# reasoning as completion tokens; at Groq's default effort an elaborate recipe
# spent ~2500 of its 4500-token budget thinking and truncated mid-JSON. "low"
# roughly halves cost and latency with no quality loss on these prompts.
# Blank disables it. Models that reject the parameter self-heal at runtime.
GROQ_REASONING_EFFORT=


# Generated header photos. Every dish TheMealDB does not have gets one, drawn
# from the recipe's own description. Without a key those dishes get no hero.
GEMINI_API_KEY=
# Set to 0 to keep the key but stop generating.
IMAGE_GENERATION=1
# Public Supabase Storage bucket the generated images are kept in. Created
# automatically on first use.
DISH_IMAGE_BUCKET=dish-images
